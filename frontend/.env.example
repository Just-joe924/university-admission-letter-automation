# Frontend environment variables (Vite).
# Copy this file to `.env` for local development and fill in real values.
# Only variables prefixed with VITE_ are exposed to the browser at BUILD time.

# Base URL of the backend API, including the /api path and NO trailing slash.
# Local dev:   http://localhost:5000/api
# Production:  https://your-backend-host.com/api
VITE_API_URL=http://localhost:5000/api

# Supabase (only needed if the frontend talks to Supabase directly).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
